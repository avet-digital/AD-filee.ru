<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:c="using:Filee.App.Controls"
             xmlns:v="using:Filee.App.Views"
             x:Class="Filee.App.Views.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel">
  <StackPanel Spacing="18">
    <TextBlock Classes="h1" Text="{DynamicResource about.title}" />
    <Border Classes="card">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <Image Source="avares://Filee/Assets/Icons/filee.png" Width="72" Height="72" />
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="Filee" FontSize="24" FontWeight="Bold" />
          <TextBlock Classes="muted" Text="{Binding Version}" />
          <TextBlock Classes="muted" Text="{DynamicResource about.license}" />
          <Button Classes="ghost" Padding="0" Click="OnOpenRepository" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Link}" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding RepositoryUrl}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- Avet Digital's Russian build: logo and contacts -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="{DynamicResource about.build_title}" />
        <WrapPanel>
          <Image Source="avares://Filee/Assets/Brand/avet-digital.png" Width="160" Height="96" Margin="0,0,18,8"
                 VerticalAlignment="Top" />
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock TextWrapping="Wrap" Text="{DynamicResource about.build_text}" />
            <Button Classes="ghost" Padding="0" Click="OnOpenLink" Tag="https://avetdigital.ru/" Margin="0,4,0,0">
              <TextBlock Text="avetdigital.ru" Foreground="{DynamicResource AccentBrush}" />
            </Button>
            <Button Classes="ghost" Padding="0" Click="OnOpenLink" Tag="https://t.me/AVET_DIGITAL">
              <TextBlock Text="Telegram: @AVET_DIGITAL" Foreground="{DynamicResource AccentBrush}" />
            </Button>
            <Button Classes="ghost" Padding="0" Click="OnOpenLink" Tag="mailto:info@avetdigital.ru">
              <TextBlock Text="info@avetdigital.ru" Foreground="{DynamicResource AccentBrush}" />
            </Button>
            <Button Classes="ghost" Padding="0" Click="OnOpenLink" Tag="tel:+79777700099">
              <TextBlock Text="+7 (977) 77-000-99" Foreground="{DynamicResource AccentBrush}" />
            </Button>
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>
    <!-- The sponsors right below Filee itself, while there are any -->
    <Border Classes="card" IsVisible="{Binding #Supporters.IsVisible}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="{DynamicResource sponsor.thanks}" />
        <v:SupportersView x:Name="Supporters" ShowTitle="False" LogoHeight="40" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="{DynamicResource about.updates}" />
        <ToggleSwitch Content="{DynamicResource general.check_updates}" IsChecked="{Binding CheckForUpdates}" />
        <WrapPanel>
          <Button Content="{DynamicResource general.check_now}" Command="{Binding CheckNowCommand}" Margin="0,0,10,0" />
          <Button Classes="accent" Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding UpdateAvailable}" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Download}" />
              <TextBlock Text="{Binding UpdateButtonText}" />
            </StackPanel>
          </Button>
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding UpdateStatus}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="{DynamicResource about.support_title}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource about.support_text}" />
        <WrapPanel>
          <Button Classes="accent" Click="OnStar" Margin="0,0,8,0" Content="{DynamicResource feedback.star}" />
          <Button Click="OnIssue" Content="{DynamicResource feedback.issue}" Margin="0,0,8,0" />
          <Button Click="OnSponsor">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Heart}" Foreground="#D4537E" />
              <TextBlock Text="{DynamicResource about.sponsor}" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="{DynamicResource about.notices}" />
        <c:MarkdownView Markdown="{Binding Notices}" SkipTitle="True" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
