<!--
  Shared MSBuild settings for every project in the repository.
  Keep project files small: anything common belongs here.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are reported by review, not by the compiler; documenting only the non-obvious
         parameters of a member is fine (CS1573). -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <Version>2.0.0</Version>
    <Product>Filee</Product>
    <Authors>Avet Digital</Authors>
    <Company>Avet Digital</Company>
    <Copyright>Copyright (c) 2026 Avet Digital</Copyright>

    <!-- Single source of truth for the GitHub repository (used by the updater and the About page). -->
    <!-- Avet Digital's build: updates come from our releases. Upstream: https://github.com/KnifeLemon/Filee -->
    <FileeRepositoryUrl>https://github.com/avet-digital/AD-filee.ru</FileeRepositoryUrl>
    <RepositoryUrl>$(FileeRepositoryUrl)</RepositoryUrl>
  </PropertyGroup>
</Project>
